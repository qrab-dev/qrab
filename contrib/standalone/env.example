# Settings for contrib/standalone/compose.yaml: copy to .env beside it and
# edit. See docs/standalone.md.

# The manager image (required): the one that "The image" in
# docs/standalone.md builds, or another reference.
QRAB_MANAGER_IMAGE=localhost/qrab/manager:dev

# Another VM config file (default ./vm.json).
#QRAB_VM_CONFIG=./vm.json

# With compose.kvm.yaml and Docker: the host's numeric kvm GID.
#QRAB_KVM_GROUP=78
