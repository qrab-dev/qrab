ARG RUST_IMAGE=docker.io/library/rust@sha256:4277ce860337f6cfa1b679891bbf689a447f4b3f4f55701742614ad31321cee7
ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
FROM ${RUST_IMAGE} AS manager-build
WORKDIR /src
COPY contrib/images/cargo-fresh /usr/local/bin/cargo-fresh
ARG QRAB_REVISION=unknown
COPY Cargo.toml Cargo.lock ./
COPY projects ./projects
RUN --mount=type=cache,id=qrab-cargo-registry,target=/usr/local/cargo/registry --mount=type=cache,id=qrab-manager-target,target=/src/target,sharing=locked cargo-fresh prepare \
    && cargo build --release --locked -p qrab-manager --bin qrab-manager \
    && rustup target add x86_64-unknown-linux-musl \
    && cargo build --release --locked --target x86_64-unknown-linux-musl -p qrab-guest-agent --bin qrab-guest-agent \
    && cargo-fresh collect "$QRAB_REVISION" /out /src/target/release/qrab-manager \
        /src/target/x86_64-unknown-linux-musl/release/qrab-guest-agent

FROM ${DEBIAN_IMAGE} AS demo-guest
COPY --from=manager-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY contrib/images/apt-https.sh /usr/local/libexec/qrab-apt-https
RUN sh /usr/local/libexec/qrab-apt-https && apt-get update --error-on=any && apt-get install -y --no-install-recommends linux-image-amd64 busybox-static kmod zstd python3 gzip tpm2-tools systemd-ukify systemd-boot-efi dosfstools mtools fdisk e2fsprogs diffutils && rm -rf /var/lib/apt/lists/*
COPY contrib/images/guest-init /guest/init
COPY contrib/images/make-initramfs.py /make-initramfs.py
COPY contrib/images/prepare-guest.py /prepare-guest.py
COPY contrib/images/guest-disk-probe /guest/usr/bin/qrab-disk-probe
COPY --from=manager-build /out/qrab-guest-agent /guest/usr/sbin/qrab-guest-agent
COPY contrib/images/guest-update-hook /guest/etc/qrab/update-hook
COPY contrib/images/make-uefi-boot.py /make-uefi-boot.py
RUN python3 /prepare-guest.py \
    && chmod 0755 /guest/init /guest/usr/bin/qrab-disk-probe /guest/usr/sbin/qrab-guest-agent \
        /guest/etc/qrab/update-hook \
    && chmod 0755 /guest/etc/qrab && python3 /make-initramfs.py /guest /out/initramfs.gz && python3 /make-uefi-boot.py

FROM ${DEBIAN_IMAGE}
COPY --from=manager-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY contrib/images/apt-https.sh /usr/local/libexec/qrab-apt-https
ARG QRAB_REVISION=unknown
# The source repository URL, from build.sh's QRAB_SOURCE_URL (empty: unset).
ARG QRAB_SOURCE_URL=
LABEL org.opencontainers.image.source="${QRAB_SOURCE_URL}" \
      org.opencontainers.image.revision="${QRAB_REVISION}"
LABEL org.opencontainers.image.description="qrab's per-VM QEMU supervisor on Debian's QEMU, with a measured UEFI Linux and TPM 2.0 demo guest"
# Debian's QEMU, swtpm and OVMF; qemu-block-extra carries QEMU's iSCSI driver.
# runtime-packages.txt records the versions.
RUN sh /usr/local/libexec/qrab-apt-https && apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends qemu-system-x86 qemu-utils qemu-block-extra ovmf swtpm ca-certificates \
    && install -D -m 0644 /usr/share/OVMF/OVMF_CODE_4M.fd /opt/qrab/firmware/OVMF_CODE_4M.fd \
    && install -D -m 0444 /usr/share/OVMF/OVMF_CODE_4M.secboot.fd /opt/qrab/firmware/OVMF_CODE_4M.secboot.fd \
    && install -D -m 0644 /usr/share/OVMF/OVMF_VARS_4M.fd /opt/qrab/firmware/OVMF_VARS_4M.fd \
    && mkdir -p /usr/share/doc/qrab-manager \
    && dpkg-query -W qemu-system-x86 qemu-utils qemu-block-extra ovmf swtpm libtpms0 > /usr/share/doc/qrab-manager/runtime-packages.txt \
    && rm -rf /var/lib/apt/lists/*
COPY --from=manager-build /out/qrab-manager /usr/local/bin/qrab-manager
COPY --from=manager-build /out/build-revision /usr/share/qrab/build-revision
COPY --from=demo-guest /out /opt/qrab/demo
COPY contrib/images/vm.json /etc/qrab/vm.json
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/qrab-manager"]
CMD ["run", "--config", "/etc/qrab/vm.json"]
